// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS ---

enum Role {
  super_admin
  region_admin
  member
}

enum VerificationStatus {
  unverified
  pending
  verified
}

enum MutationStatus {
  requested
  approved
  rejected
}

// --- CORE MODELS (WILAYAH & USER) ---

model Region {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  logoUrl     String?
  createdAt   DateTime  @default(now())

  // Relasi Keanggotaan
  profiles    Profile[] @relation("CurrentRegion")
  
  // Relasi Mutasi (Perpindahan)
  mutationsFrom RegionMutation[] @relation("FromRegion")
  mutationsTo   RegionMutation[] @relation("ToRegion")

  // Relasi Konten & Organisasi
  orgMembers  OrgMember[]
  articles    Article[] // Berita (Satu arah)
  events      Event[]   @relation("EventHosts") // Kegiatan (Kolaborasi Many-to-Many)
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  passwordHash       String
  role               Role      @default(member)
  verificationStatus VerificationStatus @default(unverified)
  
  profile            Profile?
  mutations          RegionMutation[] 
  
  // --- HUBUNGAN BARU (TAMBAHKAN INI) ---
  articles           Article[]          // Relasi ke Berita yang ditulis
  events             Event[]            // Relasi ke Event yang dibuat
  participations     EventParticipant[] // Relasi ke Event yang diikuti

  createdAt          DateTime  @default(now())
}

model Profile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  
  currentRegionId Int
  region          Region   @relation("CurrentRegion", fields: [currentRegionId], references: [id])

  // Data Biodata
  fullName        String
  graduationYear  Int
  santriId        String?  // Nullable
  phoneNumber     String   @unique
  
  // Data Tambahan (Update Mandiri)
  profession      String?
  bloodType       String?
  address         String?  @db.Text
  
  updatedAt       DateTime @updatedAt
}

// --- MUTATION SYSTEM (PERPINDAHAN) ---

model RegionMutation {
  id           Int            @id @default(autoincrement())
  userId       Int
  user         User           @relation(fields: [userId], references: [id])
  
  fromRegionId Int
  fromRegion   Region         @relation("FromRegion", fields: [fromRegionId], references: [id])
  
  toRegionId   Int
  toRegion     Region         @relation("ToRegion", fields: [toRegionId], references: [id])
  
  status       MutationStatus @default(requested)
  reason       String?        @db.Text
  
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// --- ORGANIZATION STRUCTURE ---

model OrgMember {
  id        Int     @id @default(autoincrement())
  name      String
  position  String
  order     Int     @default(100) // 1 = Ketua, dst.
  imageUrl  String?
  
  regionId  Int
  region    Region  @relation(fields: [regionId], references: [id])
}

// --- NEWS (ARTIKEL/BERITA) ---

// 1. BERITA (Artikel satu arah)
model Article {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  excerpt   String   @db.Text
  content   String   @db.Text
  imageUrl  String?
  
  regionId  Int
  region    Region   @relation(fields: [regionId], references: [id])
  
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 2. KEGIATAN (Agenda Kolaboratif)
model Event {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  description String    @db.Text
  location    String    // Online / Offline location
  eventDate   DateTime  // Waktu pelaksanaan
  imageUrl    String?

  // Many-to-Many: Satu event bisa diselenggarakan BANYAK region
  regions     Region[]  @relation("EventHosts")

  // Many-to-Many: Satu event punya BANYAK peserta
  participants EventParticipant[]

  authorId    Int
  author      User      @relation(fields: [authorId], references: [id])

  createdAt   DateTime @default(now())
}

// 3. PESERTA EVENT (Pivot Table)
model EventParticipant {
  id        Int      @id @default(autoincrement())
  eventId   Int
  event     Event    @relation(fields: [eventId], references: [id])
  
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  joinedAt  DateTime @default(now())

  @@unique([eventId, userId]) // Mencegah double join
}